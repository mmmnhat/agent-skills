{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchPlan",
  "description": "Atomic corrective instructions generated by Evaluation Harness to repair timeline invariant violations",
  "type": "object",
  "required": ["patch_id", "sequence_name", "cycle_index", "triggered_by_invariants", "operations"],
  "properties": {
    "patch_id": { "type": "string" },
    "sequence_name": { "type": "string" },
    "cycle_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "triggered_by_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["INV-01", "INV-02", "INV-03", "INV-04", "INV-05"]
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op_type", "track"],
        "properties": {
          "op_type": {
            "type": "string",
            "enum": [
              "ripple_delete",
              "move_clip",
              "adjust_audio_levels",
              "move_clip_to_track",
              "trim_clip",
              "add_marker"
            ]
          },
          "track": { "type": "string" },
          "target_clip_id": { "type": "string" },
          "clip_name": { "type": "string" },
          "start_frame": { "type": "integer" },
          "end_frame": { "type": "integer" },
          "delta_frames": { "type": "integer" },
          "gain_db": { "type": "number" },
          "dest_track": { "type": "string" },
          "marker_color": { "type": "string" },
          "marker_comment": { "type": "string" }
        }
      }
    }
  }
}

{
  "hardware": {
    "encoder": "auto",
    "description": "Auto-probed via setup_env.py (NVENC, VideoToolbox, QSV, or libx264)"
  },
  "asset_directories": {
    "sfx_dir": "",
    "bgm_dir": ""
  },
  "target_platforms": {
    "reels_shorts": {
      "aspect_ratio": "9:16",
      "resolution": [1080, 1920],
      "fps": 60,
      "max_clip_duration_sec": 4.5
    },
    "landscape_youtube": {
      "aspect_ratio": "16:9",
      "resolution": [1920, 1080],
      "fps": 60,
      "max_clip_duration_sec": 8.0
    }
  },
  "audio_layout": {
    "tracks": {
      "V1": "Video Clips (Fast-Cut)",
      "A1": "Original Ambient Sound",
      "A2": "Voiceover (Reserved Blank)",
      "A3": "Transition SFX (Whoosh)",
      "A4": "Climax SFX (Impact / Punch)",
      "A5": "Background Music (Ducked BGM)"
    }
  }
}
